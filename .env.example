# Your domain should resolve to the VPS. For IP-only HTTP tests use :80.
STREAM_DOMAIN=stream.example.com
# Use the one-command installer to generate a unique administrator account.
ADMIN_USERNAME=admin
# Generate with: openssl rand -hex 24
ADMIN_PASSWORD=CHANGE_ME
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
# Set false ONLY for temporary HTTP/IP tests.
COOKIE_SECURE=true
# Largest accepted upload in megabytes
MAX_UPLOAD_MB=1024

# Shared VPS scene encoder profile. Higher presets use more CPU.
SCENE_ENCODER_PRESET=ultrafast
SCENE_ENCODER_THREADS=2
SCENE_VIDEO_BITRATE_KBPS=2500

# Stable release auto-updates: systemd checks every six hours.
AUTO_UPDATE_ENABLED=true
# Safer default: do not restart FFmpeg while any channel wants to stream.
AUTO_UPDATE_ALLOW_LIVE=false
