[Unit]
Description=Check and apply a stable StreamCore GitHub Release
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/streamcore
ExecStart=/usr/bin/bash /opt/streamcore/scripts/update-release.sh
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
