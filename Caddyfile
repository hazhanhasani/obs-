{$STREAM_DOMAIN} {
  encode zstd gzip

  # Public HLS playback. The stream origin is not directly exposed.
  handle_path /live/* {
    reverse_proxy mediamtx:8888
  }

  handle /health {
    respond "StreamCore gateway online" 200
  }

  handle {
    respond "StreamCore v0.1.0: /live/main/index.m3u8" 200
  }
}
